# These are the environment variables docker-compose.yml sets for each
# service. This file documents them for local (non-Docker) runs; it is
# not read automatically by either service or by docker-compose.

# --- payments-service ---------------------------------------------
HTTP_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=payments
DB_USER=payments
DB_PASSWORD=payments

# --- payment-processor ----------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=payment-processor
KAFKA_TOPIC_PAYMENTS_CREATED=payments.created
KAFKA_TOPIC_PAYMENTS_PROCESSED=payments.processed
KAFKA_TOPIC_PAYMENTS_DLQ=payments.dlq

# Bounded worker pool: max simultaneously-executing payment jobs.
# Must be > 0 (fails fast at startup otherwise).
WORKER_COUNT=10

# Bounded job queue capacity. Once full, Kafka ingestion naturally
# blocks (backpressure) instead of growing an unbounded queue.
# Must be > 0.
WORKER_QUEUE_SIZE=100

# Per-job processing timeout (context.WithTimeout). Must be > 0.
PAYMENT_PROCESSING_TIMEOUT=5s

# Bounded in-process retry attempts for retryable failures (e.g. a
# transient Kafka publish error) before dead-lettering. Must be >= 0.
PAYMENT_MAX_RETRIES=3

# Fixed backoff between retry attempts. Must be > 0.
PAYMENT_RETRY_BACKOFF=200ms

# Port the /metrics (Prometheus) endpoint listens on.
METRICS_PORT=9091

# --- analytics-service -----------------------------------------------
HTTP_PORT=8082
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
# The official ClickHouse image disables network access for 'default'
# entirely unless a password is set — local dev-only credential.
CLICKHOUSE_PASSWORD=analytics

KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=analytics-service
KAFKA_TOPIC_PAYMENTS_PROCESSED=payments.processed
KAFKA_TOPIC_PAYMENTS_DLQ=payments.dlq

# Kafka ingestion batching before a bulk ClickHouse insert. Must be > 0.
ANALYTICS_BATCH_MAX_SIZE=500
ANALYTICS_BATCH_MAX_INTERVAL=2s

# --- scripts/seed (benchmark/seed tooling, not a running service) ----
# Flags override these; only used as fallback defaults.
SEED_MARIADB_DSN="payments:payments@tcp(localhost:3306)/payments?parseTime=true"
SEED_CLICKHOUSE_ADDR=localhost:9000
SEED_CLICKHOUSE_DATABASE=analytics
SEED_CLICKHOUSE_USER=default
SEED_CLICKHOUSE_PASSWORD=analytics
