# Terraform working files — never commit local state, plan output, or
# provider plugin caches. The dependency lock file (.terraform.lock.hcl)
# IS committed (one per environment/bootstrap directory), so provider
# versions are reproducible across machines and CI.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log

# Real variable files contain environment-specific (though not secret —
# passwords are generated by Terraform into Secrets Manager, never
# stored in a .tfvars file) values. Only the committed *.tfvars.example
# files are meant to be tracked.
*.tfvars
!*.tfvars.example

# Editor/OS noise
.DS_Store
