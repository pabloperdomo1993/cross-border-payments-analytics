# Copy to terraform.tfvars and replace every dummy value below with a
# real one before running `terraform apply` against an actual AWS
# account. Nothing here has been applied or validated against real AWS
# (see infrastructure/README.md).

environment = "staging"
aws_region  = "us-east-1"
vpc_cidr    = "10.1.0.0/16"

acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/00000000-0000-0000-0000-000000000000"

frontend_bucket_name = "cbpa-staging-frontend-123456789012"

frontend_domain_name         = null
frontend_acm_certificate_arn = null
