{
  "title": "Cross-Border Payments — Platform Overview",
  "uid": "cbpa-platform-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["cross-border-payments-analytics"],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Payments Created",
      "description": "payments_created_total (payments-service). Cumulative count since the process started.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "payments_created_total", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Completed Payments",
      "description": "payments_processing_total{status=\"completed\"} (payment-processor).",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "payments_processing_total{status=\"completed\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed Payments",
      "description": "payments_processing_total{status=\"failed\"} (payment-processor).",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "payments_processing_total{status=\"failed\"}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Workers",
      "description": "payment_worker_active (payment-processor worker pool gauge).",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "payment_worker_active", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Request Rate",
      "description": "sum by (job) (rate(http_requests_total[1m])) — payments-service and analytics-service only; payment-processor's small /health,/ready,/metrics surface isn't wrapped in HTTP metrics middleware.",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (rate(http_requests_total[1m]))", "legendFormat": "{{job}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP P95 Latency",
      "description": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "{{job}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "HTTP Error Rate",
      "description": "sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (job) (rate(http_requests_total[5m]))",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (job) (rate(http_requests_total[5m]))", "legendFormat": "{{job}}", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Payments Processed (rate)",
      "description": "sum(rate(payments_processing_total[5m])) — every processing outcome (completed or failed), payment-processor.",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(payments_processing_total[5m]))", "legendFormat": "processed/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Payment Processing Rate",
      "description": "Same underlying signal as \"Payments Processed (rate)\" — no separate metric distinguishes them; both are sum(rate(payments_processing_total[5m])). Kept as two panels because the spec asked for both a 'processed' and a 'processing rate' view.",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(payments_processing_total[5m]))", "legendFormat": "processing/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Payment Processing Latency (P50 / P95 / P99)",
      "description": "histogram_quantile over payment_processing_duration_seconds_bucket (payment-processor, unlabeled histogram).",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, rate(payment_processing_duration_seconds_bucket[5m]))", "legendFormat": "p50", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "histogram_quantile(0.95, rate(payment_processing_duration_seconds_bucket[5m]))", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "C", "expr": "histogram_quantile(0.99, rate(payment_processing_duration_seconds_bucket[5m]))", "legendFormat": "p99", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Worker Queue Depth",
      "description": "payment_worker_queue_size vs. payment_worker_queue_capacity (payment-processor worker pool gauges).",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "payment_worker_queue_size", "legendFormat": "queue size", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "refId": "B", "expr": "payment_worker_queue_capacity", "legendFormat": "capacity", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Kafka Messages Consumed",
      "description": "rate(kafka_messages_consumed_total[5m]) — analytics-service, per payments.processed/payments.dlq message consumed.",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(kafka_messages_consumed_total[5m])", "legendFormat": "consumed/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Kafka Processing Errors",
      "description": "No generic kafka_processing_errors_total metric exists. analytics-service's only per-message work is the ClickHouse batch insert, so an insert failure IS the Kafka-processing failure here — this panel maps to rate(clickhouse_insert_errors_total[5m]) rather than inventing a duplicate metric.",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "rate(clickhouse_insert_errors_total[5m])", "legendFormat": "insert errors/s", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] }
    }
  ]
}
